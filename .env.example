# Documentation only: use cPanel Environment variables, never commit secrets.
NODE_ENV=production
PUBLIC_ORIGIN=https://autotest.autohaus.bg
ALLOWED_HOSTS=
TRUST_PROXY=0

# Existing optional mail integration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Existing legacy helpers; active roles come from Supabase RPC/RLS.
CLOUDINARY_CLOUD_NAME=
ADMIN_EMAILS=

# Standalone only. Passenger controls its socket.
# PORT=3217
# HOST=127.0.0.1

# Supabase URL/publishable key are fixed in server/admin-lib.js.
# SUPABASE_URL / SUPABASE_ANON_KEY / service-role keys are not consumed here.
# Never copy Vercel OIDC tokens or publish privileged keys.

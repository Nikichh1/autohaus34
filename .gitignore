# This is a static site — no Node build. The files below are local tooling
# only (used to generate responsive image derivatives with `sharp`) and must
# not be committed: node_modules carries platform-specific native binaries,
# and a stray package.json makes Vercel attempt a Node build instead of
# serving the files statically.
node_modules/
package.json
package-lock.json

# scratch: the one-shot image-derivative generator, recreated when needed
_gen-derivs.js

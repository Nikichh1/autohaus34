# Netlify / Cloudflare Pages read this file directly. Vercel uses vercel.json.
# Asset URLs carry ?v=<hash> stamped by build.js, so versioned CSS/JS/fonts
# may be cached forever while HTML remains revalidated.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Permitted-Cross-Domain-Policies: none
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), serial=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' blob: data: https://res.cloudinary.com https://autohaus.bg https://www.autohaus.bg https://ajoiqomflplhadyhxvfe.supabase.co; connect-src 'self' https://api.cloudinary.com https://res.cloudinary.com https://ajoiqomflplhadyhxvfe.supabase.co https://ajoiqomflplhadyhxvfe.storage.supabase.co; worker-src 'self' blob:

/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/img/*
  Cache-Control: public, max-age=31536000, immutable
/img/v/*
  Cross-Origin-Resource-Policy: same-origin
  X-Robots-Tag: noindex, noimageindex, noarchive
/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
